{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "steps": {
      "type": "number",
      "default": 0
    },
    "walking_distance_km": {
      "type": "number",
      "default": 0
    },
    "running_distance_km": {
      "type": "number",
      "default": 0
    },
    "active_minutes": {
      "type": "number",
      "default": 0
    },
    "calories_burned_activity": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "log_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}