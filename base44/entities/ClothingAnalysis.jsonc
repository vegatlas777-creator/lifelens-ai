{
  "name": "ClothingAnalysis",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string"
    },
    "sport_type": {
      "type": "string"
    },
    "garment_type": {
      "type": "string"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "string"
    },
    "performance_score": {
      "type": "number"
    },
    "breathability_score": {
      "type": "number"
    },
    "comfort_score": {
      "type": "number"
    },
    "durability_score": {
      "type": "number"
    },
    "fit_score": {
      "type": "number"
    },
    "recommended_sports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "summary"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}