{
  "name": "CommunityReport",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "enum": [
        "post",
        "comment"
      ]
    },
    "target_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "reporter_id": {
      "type": "string"
    }
  },
  "required": [
    "target_type",
    "target_id",
    "reason"
  ],
  "rls": {
    "create": {
      "data.reporter_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}