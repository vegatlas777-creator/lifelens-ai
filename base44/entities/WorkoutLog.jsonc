{
  "name": "WorkoutLog",
  "type": "object",
  "properties": {
    "workout_id": {
      "type": "string"
    },
    "workout_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number",
      "default": 10
    },
    "calories_burned": {
      "type": "number",
      "default": 0
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "workout_id",
    "workout_name",
    "completed_date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}