{
  "name": "UsageRecord",
  "type": "object",
  "properties": {
    "feature_type": {
      "type": "string",
      "enum": [
        "material_check",
        "calorie_analysis"
      ]
    },
    "week_start": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "feature_type",
    "week_start"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}